                <ui:Slider label="Sound Effects" value="42" high-value="100" name="SFXVolumeSlider" style="flex-direction: column; -unity-font-definition: url(&quot;project://database/Assets/3_VISUALS/4_FONTS/Poppins/Poppins-Bold.ttf?fileID=12800000&amp;guid=fdf68ea26ddd39049bb56f7760a7b83b&amp;type=3#Poppins-Bold&quot;); color: rgb(104, 34, 137); font-size: 35px;"/>
